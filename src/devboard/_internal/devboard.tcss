Screen {
    layout: horizontal;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $footer-background;
}

#task-progress {
    width: 1fr;
    min-width: 0;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

Footer {
    dock: none;
    width: auto;
    max-width: 100%;
    align-horizontal: right;
}

Footer FooterKey.-command-palette {
    border-left: none;
}

Modal {
    align: center middle;
}

#modal-contents {
    padding: 0 1;
    width: 80%;
    height: 80%;
    border: thick $panel 80%;
    background: $surface;
}

Column {
    height: 1fr;
    background: $background;
    border: round $panel;
}

Column.-focused {
    border: round $accent;
}

.column-title {
    color: $text-muted;
}

Column.-focused .column-title {
    color: $text;
    text-style: bold;
}

DataTable {
    height: 1fr;
    width: 1fr;
    scrollbar-size: 0 0;
}

DataTable > .datatable--header {
    background: $surface;
    color: $text-muted;
}

DataTable:blur > .datatable--cursor {
    background: transparent;
    color: $text;
    text-style: none;
}
