Screen {
    layout: horizontal;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $footer-background;
}

#task-progress {
    width: 1fr;
    min-width: 0;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

Footer {
    dock: none;
    width: auto;
    max-width: 100%;
    align-horizontal: right;
}

Footer FooterKey.-command-palette {
    border-left: none;
}

Modal {
    align: center middle;
}

#modal-contents {
    padding: 0 1;
    width: 80%;
    height: 80%;
    border: thick $panel 80%;
    background: $surface;
}

Column {
    height: 1fr;
    background: $background;
    border: solid $primary;
}

.column-title {
    text-align: center;
    text-style: bold underline;
}

DataTable {
    height: 1fr;
    width: 1fr;
    scrollbar-size: 0 0;
}

.datatable--header {
    background: $background;
}
